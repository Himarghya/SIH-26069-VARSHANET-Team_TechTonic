# ================================================================
# VARSHANET - National Weather Big Data Analytics Platform (India)
# Environment Configuration & API Keys
# ================================================================

APP_ENV=development

# Database Settings
# Default: SQLite (Runs immediately out of the box with zero external configuration)
# Production: PostgreSQL with PostGIS extension (e.g. postgresql://user:pass@localhost:5432/varshanet)
DATABASE_URL=sqlite:///./varshanet.db

# In-Memory Cache & Redis Pub/Sub
REDIS_URL=redis://localhost:6379/0

# Message Broker (Apache Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=false

# Object Storage / Data Lake (MinIO / S3)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword2026

# JWT Security & Auth
JWT_SECRET=varshanet-super-secret-national-weather-security-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----------------------------------------------------------------
# External Weather & News APIs (Optional / Works with built-in fallbacks if blank)
# ----------------------------------------------------------------
# 1. OpenWeatherMap API Key (Get free key from https://openweathermap.org/api)
WEATHER_API_KEY=

# 2. NewsAPI Key for Live Indian News (Get free key from https://newsapi.org)
NEWS_API_KEY=

# 3. Google Gemini API Key for Deep LLM Multi-Modal Reasoning (Optional)
GEMINI_API_KEY=

# 4. Mapbox Tile Key (Optional; OpenStreetMap & CartoDB Dark tiles used by default)
MAP_API_KEY=